rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() && myUserDoc().status == 'approved';
    }

    function sharesLocation(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.shareLocation == true;
    }

    // -------- USERS --------
    match /users/{uid} {
      // Read: self always; admins always; approved members can read public fields
      // of other approved members. We can't easily field-filter in rules, so we
      // allow the read but keep `address` as a private string (client redacts
      // in UI when `shareLocation` is false). The redaction invariant is:
      // - `address`: self + admin only (enforced in client code; if stricter
      //   enforcement is needed, move `address` to a private subcollection).
      // - `addressGeo`: others can read only if target.shareLocation == true.
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || isApproved()
      );

      // Self-create during signup (callable onUserCreate also seeds server-side).
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isAdmin == false;

      // Self-update limited to profile + notification/share toggles.
      // `emailVerified` is self-settable but only from false -> true (client
      // syncs it from Firebase Auth after the user verifies their email).
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'phone', 'address', 'addressGeo',
                       'carpoolAddress', 'carpoolAddressGeo',
                       'notificationsEnabled', 'shareLocation', 'updatedAt',
                       'emailVerified'])
        && (!('emailVerified' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.emailVerified == true);

      // Admins can update any user (approvals, eviction, admin promotion go
      // through callables, but console-driven edits should also be possible).
      allow update: if isAdmin();

      // Deletes happen via `selfDeleteAccount` callable (admin SDK).
      allow delete: if false;
    }

    // -------- CARPOOL LOCATIONS --------
    match /carpoolLocations/{locId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // -------- EVENTS --------
    match /events/{eventId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();

      match /rsvps/{uid} {
        allow read: if isApproved();
        // A member RSVPs for themselves; the `attended` flag may only be set
        // by admins. For non-admin writes, attended must be absent or false
        // on create, and unchanged on update.
        allow create: if isApproved() && request.auth.uid == uid
          && request.resource.data.get('attended', false) == false;
        allow update: if isApproved() && request.auth.uid == uid
          && request.resource.data.get('attended', false) == resource.data.get('attended', false);
        allow update, delete: if isAdmin();
      }

      match /rides/{rideId} {
        allow read: if isApproved();

        // Requester creates their own ride request.
        allow create: if isApproved()
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'open';

        // Update: driver claims the ride (open -> matched with their uid),
        // requester/admin cancels, or requester edits their pickup address.
        allow update: if isApproved() && (
          (resource.data.status == 'open'
            && request.resource.data.status == 'matched'
            && request.resource.data.driverUid == request.auth.uid
            && request.resource.data.requesterUid == resource.data.requesterUid)
          || (resource.data.status == 'matched'
            && resource.data.driverUid == request.auth.uid
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'driverUid', 'matchedAt']))
          || (request.resource.data.status == 'cancelled'
            && (request.auth.uid == resource.data.requesterUid || isAdmin()))
          || (request.auth.uid == resource.data.requesterUid
            && resource.data.status != 'cancelled'
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickup']))
        );

        allow delete: if isAdmin();
      }
    }

    // -------- BENCHMARK --------
    // Each member owns their own benchmark data. Admins (coaches) can read
    // everyone's and assign exercises; they can't edit a member's results.
    function ownsBenchmark(uid) {
      return isApproved() && request.auth.uid == uid;
    }

    // Height in inches: null, or 4 ft 0 in – 7 ft 11 in (the picker's range).
    function validHeight(h) {
      return h == null || (h is number && h >= 48 && h <= 95);
    }

    function validSession(date) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'version', 'bodyweight', 'heightIn', 'results',
                               'wallSquatFaults', 'createdAt', 'updatedAt'])
        && d.version is int && d.version >= 1
        && d.date == date
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.bodyweight is number && d.bodyweight >= 100 && d.bodyweight <= 400
        && validHeight(d.get('heightIn', null))
        // Rules can't loop over map values, so cap the size; the app writes
        // one number-or-null per test of that benchmark's version.
        && d.results is map && d.results.size() <= 50
        && d.wallSquatFaults is list && d.wallSquatFaults.size() <= 10;
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'heightIn', 'updatedAt'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 100))
        && validHeight(d.get('heightIn', null));
    }

    match /benchmarkProfiles/{uid} {
      allow read: if ownsBenchmark(uid) || isAdmin();
      allow create, update: if ownsBenchmark(uid) && validProfile();
      allow delete: if false;

      match /benchmarkSessions/{date} {
        allow read: if ownsBenchmark(uid) || isAdmin();
        allow create, update: if ownsBenchmark(uid) && validSession(date);
        allow delete: if ownsBenchmark(uid);
      }

      match /benchmarkAssignments/{assignmentId} {
        allow read: if ownsBenchmark(uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200;
        allow delete: if isAdmin();
        allow update: if false;
      }
    }

    // Coach screens query every member's benchmarks at once.
    match /{path=**}/benchmarkSessions/{date} {
      allow read: if isAdmin();
    }
    match /{path=**}/benchmarkAssignments/{assignmentId} {
      allow read: if isAdmin();
    }
  }
}
