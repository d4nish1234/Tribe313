    "lint": "echo 'no-op'"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "expo-server-sdk": "^3.10.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/node": "^22.7.5",
    "@types/node-fetch": "^2.6.11"
  }
}
